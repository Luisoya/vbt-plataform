{
  "name": "vbt-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plataforma de monitorización de la velocidad de ejecución (VBT)",
  "scripts": {
  "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
  "dev:server": "tsx watch --clear-screen=false server/index.ts",
  "dev:client": "vite --config client/vite.config.ts",
  "build": "vite build --config client/vite.config.ts",
  "start": "tsx server/index.ts",
  "test": "vitest run",
  "typecheck": "tsc --noEmit -p tsconfig.json"
},
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "better-sqlite3": "^13.2.0",
    "chart.js": "^4.6.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true
  }
}
